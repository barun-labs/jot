#!/usr/bin/env bash
# jot-config: resolve Jot's inbox file path
set -u

CONFIG="$HOME/.config/jot/config.json"
DEFAULT_FILE="$HOME/notes/inbox.md"

file=""
if [[ -f $CONFIG ]]; then
  if jq -e . "$CONFIG" >/dev/null 2>&1; then
    file="$(jq -r '.file? // empty | strings' "$CONFIG" 2>/dev/null)"
  fi
fi

file=${file%%$'\n'*}

[[ -n $file ]] || file="$DEFAULT_FILE"
file="${file/#\~/$HOME}"
[[ $file == /* ]] || file="$HOME/$file"

printf '%s\n' "$file"
